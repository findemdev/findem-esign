<% studio_workspace = signed_in? && !turbo_native_app? %>
<!DOCTYPE html>
<html data-theme="<%= studio_workspace ? 'studio' : 'docuseal' %>" lang="<%= I18n.locale %>">
  <head>
    <%= render 'layouts/head_tags' %>
    <% if Docuseal.enable_pwa? %>
      <link rel="manifest" href="/manifest.json">
    <% end %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <%= csrf_meta_tags %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <% if ENV['ROLLBAR_CLIENT_TOKEN'] %>
      <meta name="rollbar-token" content="<%= ENV.fetch('ROLLBAR_CLIENT_TOKEN', nil) %>">
      <%= javascript_pack_tag 'rollbar', 'application', defer: true %>
    <% else %>
      <%= javascript_pack_tag 'application', defer: true %>
    <% end %>
    <% if canonical_url = content_for(:canonical_url) %>
      <link href="<%= canonical_url %>" rel="canonical">
    <% end %>
    <%= stylesheet_pack_tag 'application', media: 'all', data: { turbo_track: 'dynamic' } %>
  </head>
  <body class="<%= 'studio-workspace' if studio_workspace %>">
    <% if params[:modal].present? %>
      <% modal_uri = Addressable::URI.parse(params[:modal]) %>
      <% url_params = Rails.application.routes.recognize_path(modal_uri.path, method: :get) %>
      <% if url_params[:action] == 'new' %>
        <open-modal src="<%= url_for(**url_params, params: modal_uri.query_values) %>"></open-modal>
      <% end %>
    <% end %>
    <% unless content_for?(:native_modal) %>
      <turbo-frame id="modal"></turbo-frame>
    <% end %>
    <turbo-frame id="drawer"></turbo-frame>
    <div class="<%= 'studio-shell' if studio_workspace %>">
      <% if studio_workspace %>
        <%= render 'shared/workspace_nav' %>
      <% end %>
      <div class="<%= 'studio-main' if studio_workspace %>">
        <%= render turbo_native_app? ? 'shared/native_navbar' : 'shared/navbar' %>
        <% if flash.present? %><%= render 'shared/flash' %><% end %>
        <main id="workspace_content" class="<%= studio_workspace ? 'studio-page' : 'max-w-6xl mx-auto px-4 md:px-2 mb-8' %>">
          <%= yield %>
        </main>
      </div>
    </div>
    <%= render 'shared/body_scripts' %>
  </body>
</html>
