<div class="text-center px-2 text-sm text-base-content/70">
  <% if local_assigns[:with_counter] %>
    <% count = CompletedSubmitter.distinct.count(:submission_id) %>
    <% if count > 1 %>
      <%= t('count_documents_signed_with_html', count:) %>
    <% else %>
      <%= t('powered_by') %>
    <% end %>
  <% else %>
    <%= t('powered_by') %>
  <% end %>
  <a href="<%= Docuseal::PRODUCT_URL %>" class="underline" target="_blank" rel="noopener">Findem</a> &middot; <a href="<%= Docuseal::SOURCE_URL %>" class="underline" target="_blank" rel="noopener">source</a>
</div>
